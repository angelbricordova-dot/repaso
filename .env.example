# ── Supabase (Project Settings → API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo en el servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── URL pública del sitio (para correos de confirmación) ──────
NEXT_PUBLIC_SITE_URL=https://repaso.vercel.app

# ── IA (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para kits y tutor. Por defecto claude-opus-5-5 (el más capaz).
# Para bajar costos mucho: claude-haiku-5-5  (ver README → Costos).
REPASO_AI_MODEL=claude-opus-5-5
# low | medium | high
REPASO_AI_EFFORT=medium

# ── Transcripción de clases grabadas (ElevenLabs Speech-to-Text) ──
ELEVENLABS_API_KEY=

# ── Correos con rol de administrador (separados por coma) ─────
# Al iniciar sesión con uno de estos correos se le asigna rol admin.
REPASO_ADMIN_EMAILS=tu-correo@gmail.com

# ── Contacto que aparece en la web y en los términos ──────────
NEXT_PUBLIC_CONTACT_EMAIL=hola@repaso.app
NEXT_PUBLIC_CONTACT_WHATSAPP=+58 412 000 0000
